.discover-page > .title, .discover-page > .intro { display: block; }.discover-page > .intro { margin: 20rpx 0 34rpx; color: #697078; font-size: 25rpx; line-height: 1.75; }
.constellation { position: relative; height: 590rpx; overflow: hidden; background: var(--blue); }
.orbit { position: absolute; border: 2rpx solid rgba(197,238,231,.23); border-radius: 50%; }.orbit-one { width: 470rpx; height: 470rpx; top: 58rpx; left: 80rpx; }.orbit-two { width: 300rpx; height: 300rpx; top: 142rpx; left: 164rpx; }
.interest { position: absolute; display: grid; place-items: center; color: #fff; background: var(--rust); border: 5rpx solid rgba(251,248,240,.82); border-radius: 50%; text-align: center; }.interest text { display: block; opacity: .74; font-size: 18rpx; }.interest .interest-label { opacity: 1; font-family: "Songti SC", serif; font-size: 28rpx; }
.interest.large { width: 188rpx; height: 188rpx; top: 180rpx; left: 220rpx; }.interest.large .interest-label { font-size: 35rpx; }.interest.medium { width: 142rpx; height: 142rpx; top: 60rpx; left: 70rpx; background: var(--jade); }.interest.small { width: 112rpx; height: 112rpx; }.interest.small:nth-of-type(5) { top: 90rpx; right: 50rpx; }.interest.small:nth-of-type(6) { bottom: 68rpx; left: 86rpx; background: var(--blue-soft); }.interest.tiny { width: 90rpx; height: 90rpx; right: 70rpx; bottom: 66rpx; background: var(--jade); }
.constellation-note { position: absolute; right: 24rpx; bottom: 18rpx; left: 24rpx; color: rgba(255,255,255,.55); font-size: 18rpx; text-align: center; }
.nearby { margin: 24rpx 0 44rpx; padding: 28rpx; }.nearby view { display: flex; align-items: end; justify-content: space-between; }.nearby view .nearby-title { color: var(--blue); font-family: "Songti SC", serif; font-size: 32rpx; }.nearby > text { display: block; }.nearby > text:nth-child(2) { margin: 20rpx 0 8rpx; font-size: 25rpx; }.nearby .nearby-count { display: inline; color: var(--rust); font-size: 38rpx; font-weight: 700; }.nearby .nearby-meta { color: #777; font-size: 21rpx; }
.section-title { display: block; color: var(--blue); font-family: "Songti SC", serif; font-size: 36rpx; }.recommend-list { display: grid; gap: 14rpx; margin-top: 18rpx; }.recommend-card { display: grid; grid-template-columns: 56rpx 1fr 26rpx; gap: 14rpx; align-items: center; padding: 26rpx; }.recommend-card text { display: block; }.recommend-card .index { color: var(--rust); font-family: "Songti SC", serif; }.recommend-card .recommend-title { color: var(--blue); font-size: 27rpx; font-weight: 700; }.recommend-card view > text { margin: 5rpx 0; color: #697078; font-size: 21rpx; }.recommend-card .recommend-place { color: var(--jade); font-size: 20rpx; }.recommend-card .arrow { color: var(--rust); font-size: 42rpx; }
