.scan-result { position: relative; height: 440rpx; margin: -28rpx -28rpx 24rpx; overflow: hidden; background: var(--blue); }
.scan-result image { width: 100%; height: 100%; opacity: .72; }
.scan-result::after { content: ""; position: absolute; inset: 24rpx; border: 2rpx solid rgba(255,255,255,.62); }
.scan-line { position: absolute; z-index: 2; right: 24rpx; left: 24rpx; top: 38%; height: 3rpx; background: #c5eee7; box-shadow: 0 0 24rpx #c5eee7; }
.scan-label { position: absolute; z-index: 3; right: 42rpx; bottom: 36rpx; left: 42rpx; color: #fff; }
.scan-label text { display: block; color: #c5eee7; font-size: 21rpx; }.scan-label .scan-book { margin: 7rpx 0; color: #fff; font-family: "Songti SC", serif; font-size: 48rpx; font-weight: 700; }.scan-label .scan-meta { color: #fff; font-size: 22rpx; opacity: .78; }
.reader-summary { display: grid; grid-template-columns: repeat(3, 1fr); padding: 24rpx 8rpx; text-align: center; }
.reader-summary view { padding: 0 8rpx; border-right: 2rpx solid rgba(36,59,90,.12); }.reader-summary view:last-child { border: 0; }
.reader-summary text { display: block; margin-top: 5rpx; color: #71777c; font-size: 18rpx; }.reader-summary .summary-count { color: var(--rust); font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; }
.privacy-card { display: grid; grid-template-columns: 1fr auto; gap: 24rpx; align-items: center; margin: 18rpx 0; padding: 24rpx; }
.privacy-card text { display: block; color: #71777c; font-size: 20rpx; line-height: 1.55; }
.privacy-card .privacy-title { margin-bottom: 6rpx; color: var(--blue); font-size: 25rpx; font-weight: 700; }
.reading-now { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; margin-bottom: 42rpx; padding: 22rpx 24rpx; }
.reading-now text { display: block; }
.reading-title { color: var(--blue); font-family: "Songti SC", serif; font-size: 30rpx; }
.reading-now > text { max-width: 58%; color: #697078; font-size: 21rpx; line-height: 1.55; text-align: right; }
.section-title-row { display: flex; align-items: end; justify-content: space-between; }.section-title-row > text { color: #777; font-size: 21rpx; }
.section-title { display: block; color: var(--blue); font-family: "Songti SC", serif; font-size: 36rpx; }
.note-list { display: grid; gap: 14rpx; margin-top: 18rpx; }.note-card { padding: 24rpx; }.note-card view { display: flex; justify-content: space-between; margin-bottom: 12rpx; }.note-card view .note-author { color: var(--blue); font-size: 25rpx; font-weight: 700; }.note-card view text { color: #888; font-size: 20rpx; }.note-card > text { font-size: 25rpx; line-height: 1.7; }
.note-input { display: flex; margin-top: 14rpx; padding: 10rpx; }.note-input input { min-width: 0; height: 76rpx; flex: 1; padding: 0 16rpx; font-size: 24rpx; }.note-input button { width: 116rpx; display: grid; place-items: center; color: #fff; background: var(--blue); border-radius: 2rpx; font-size: 24rpx; }
.ar-preview { min-height: 148rpx; display: grid; grid-template-columns: 70rpx 1fr 28rpx; gap: 16rpx; align-items: center; margin: 38rpx 0; padding: 24rpx; color: #fff; background: var(--blue); border-radius: 4rpx; text-align: left; }.ar-preview .ar-title, .ar-preview view text { display: block; }.ar-preview .ar-title { font-size: 28rpx; font-weight: 700; }.ar-preview view text { margin-top: 7rpx; font-size: 20rpx; opacity: .72; }.ar-mark { width: 62rpx; height: 62rpx; display: grid; place-items: center; border: 2rpx solid #c5eee7; border-radius: 50%; font-size: 23rpx; }.arrow { font-size: 42rpx; }
.recommend { margin-top: 20rpx; }.recommend-item { display: grid; grid-template-columns: 45rpx 1fr 24rpx; align-items: center; padding: 25rpx 0; border-bottom: 2rpx solid rgba(36,59,90,.13); }.recommend-item > text:first-child { color: var(--rust); font-family: "Songti SC", serif; }.recommend-title { display: block; color: var(--blue); font-size: 25rpx; font-weight: 700; }.recommend-meta { display: block; margin-top: 5rpx; color: #697078; font-size: 20rpx; }
.scan-again { margin-top: 26rpx; }
