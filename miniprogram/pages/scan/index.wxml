<view class="page scan-page">
  <view class="scan-result">
    <view class="scan-line"></view>
    <image src="/assets/art-reference.jpg" mode="aspectFill"></image>
    <view class="scan-label"><text>识别成功</text><text class="scan-book">《资治通鉴》</text><text class="scan-meta">史部 · 编年类</text></view>
  </view>

  <view class="reader-summary card">
    <view><text class="summary-count">38</text><text>位读者读过</text></view>
    <view><text class="summary-count">3</text><text>位正在馆内阅读</text></view>
    <view><text class="summary-count">{{notes.length}}</text><text>条书旁留言</text></view>
  </view>

  <view class="privacy-card card">
    <view><text class="privacy-title">允许被同好发现</text><text>开启后只显示“二层社科区”，不公开身份和精确座位。</text></view>
    <switch color="#6f9f97" checked="{{discoverable}}" bindchange="toggleDiscoverable"></switch>
  </view>

  <view class="reading-now card">
    <view><text class="eyebrow">READING NOW</text><text class="reading-title">此刻同读</text></view>
    <text>二层社科区有 2 位，四层地方文献区有 1 位</text>
  </view>

  <view class="section-title-row"><view><text class="eyebrow">BOOKSIDE NOTES</text><text class="section-title">书旁留言</text></view><text>按时间</text></view>
  <view class="note-list">
    <view class="note-card card" wx:for="{{notes}}" wx:key="id"><view><text class="note-author">{{item.name}}</text><text>{{item.time}}</text></view><text>{{item.text}}</text></view>
  </view>
  <view class="note-input card"><input value="{{note}}" bindinput="updateNote" maxlength="42" placeholder="你想在书旁留下什么？"></input><button bindtap="submitNote">留下</button></view>

  <button class="ar-preview" bindtap="previewAR"><text class="ar-mark">AR</text><view><text class="ar-title">查看这本书的穿越场景</text><text>手机端轻量体验 · 眼镜端完整呈现</text></view><text class="arrow">›</text></button>

  <view class="recommend">
    <text class="eyebrow">NEXT DISCOVERY</text><text class="section-title">相关馆藏与活动</text>
    <view class="recommend-item" wx:for="{{recommendations}}" wx:key="title" data-index="{{index}}" bindtap="openRecommendation" role="button">
      <text>{{index + 1}}</text><view><text class="recommend-title">{{item.title}}</text><text class="recommend-meta">{{item.type}} · {{item.place}}</text></view><text>›</text>
    </view>
  </view>

  <button class="secondary scan-again" bindtap="scanAgain">扫描另一本书</button>

  <view class="bottom-nav">
    <button bindtap="openHome"><text class="nav-icon">卷</text><text>首页</text></button>
    <button class="active"><text class="nav-icon">扫</text><text>扫书</text></button>
    <button bindtap="openDiscover"><text class="nav-icon">星</text><text>同好</text></button>
  </view>
</view>
